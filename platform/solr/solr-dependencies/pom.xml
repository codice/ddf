<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>platform-solr</artifactId>
        <groupId>ddf.platform.solr</groupId>
        <version>2.32.2-SNAPSHOT</version>
    </parent>
    <artifactId>solr-dependencies</artifactId>
    <name>DDF :: Platform :: Solr :: Dependencies</name>
    <description>Contains Solr dependencies. Exports solr related packages required by DDF.</description>
    <packaging>bundle</packaging>
    <dependencies>
        <dependency>
            <groupId>org.apache.solr</groupId>
            <artifactId>solr-api</artifactId>
            <version>${solr.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.solr</groupId>
            <artifactId>solr-solrj</artifactId>
            <version>${solr.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>jcl-over-slf4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.solr</groupId>
            <artifactId>solr-solrj-zookeeper</artifactId>
            <version>${solr.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>jcl-over-slf4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
        </dependency>
        <!-- SolrJ 10 uses the JDK HTTP client; logging is supplied by Pax Logging at runtime. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${solr.slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.zookeeper</groupId>
            <artifactId>zookeeper</artifactId>
            <version>${solr.zookeeper.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-annotations</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-transport</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-handler</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-common</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-transport-native-epoll</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.zookeeper</groupId>
            <artifactId>zookeeper-jute</artifactId>
            <version>${solr.zookeeper.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-annotations</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
            <version>${solr.netty.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.artifactId}</Bundle-SymbolicName>
                        <Require-Capability>osgi.ee;filter:="(&amp;(osgi.ee=JavaSE)(version&gt;=17))"</Require-Capability>
                        <Export-Package>
                            <!--packages required for solrj -->
                            org.apache.jute;version=${solr.zookeeper.version},
                            org.apache.solr.client.solrj.*;version=${solr.version},
                            org.apache.solr.client.api.*;version=${solr.version},
                            org.apache.curator.*;version=5.9.0,
                            io.swagger.v3.oas.annotations.*;version=2.2.54,
                            org.apache.yetus.audience;version=0.12.0,
                            org.apache.solr.common.*;version=${solr.version},
                            org.apache.zookeeper.*;version=${solr.zookeeper.version},
                            org.noggit;version=${solr.version}
                        </Export-Package>
                        <Embed-Transitive>true</Embed-Transitive>
                        <Embed-Dependency>
                            solr-api,
                            solr-solrj,
                            solr-solrj-zookeeper,
                            commons-io,
                            zookeeper,
                            zookeeper-jute,
                            curator-client,
                            curator-framework,
                            semver4j,
                            swagger-annotations-jakarta,
                            audience-annotations
                        </Embed-Dependency>
                        <Import-Package>
                            org.slf4j.*;version="[2.0,3)",
                            <!-- Optional Jetty transport, ZooKeeper server/CLI, and annotation-only dependencies. -->
                            org.apache.solr.client.solrj.jetty;resolution:=optional,
                            org.eclipse.jetty.*;resolution:=optional,
                            javax.servlet.*;resolution:=optional,
                            javax.annotation;resolution:=optional,
                            javax.annotation.meta;resolution:=optional,
                            <!-- Shaded Guava platform integrations and annotation/doclet metadata are not client requirements. -->
                            android.os;resolution:=optional,
                            com.sun.javadoc;resolution:=optional,
                            com.sun.tools.doclets.standard;resolution:=optional,
                            org.apache.curator.shaded.com.google.appengine.*;resolution:=optional,
                            org.apache.curator.shaded.com.google.apphosting.*;resolution:=optional,
                            org.apache.curator.shaded.com.google.errorprone.*;resolution:=optional,
                            org.checkerframework.*;resolution:=optional,
                            org.jspecify.annotations;resolution:=optional,
                            org.apache.commons.cli;resolution:=optional,
                            org.jline.*;resolution:=optional,
                            org.xerial.snappy;resolution:=optional,
                            org.apache.log4j.jmx;resolution:=optional,
                            net.jcip.annotations;resolution:=optional,
                            io.netty.channel.epoll;resolution:=optional,
                            <!-- Discover new SolrJ 10 requirements rather than silently omitting them. -->
                            *
                        </Import-Package>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-artifact-size</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <ArtifactSizeEnforcerRule implementation="org.codice.maven.artifactsize.ArtifactSizeEnforcerRule">
                                    <!-- SolrJ 10's required Curator client includes shaded Guava; keep it isolated from DDF's Guava. -->
                                    <maxArtifactSize>8_MB</maxArtifactSize>
                                </ArtifactSizeEnforcerRule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
